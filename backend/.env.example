# ==============================================================================
# CHRONOS-COASTAL Environment Configuration Template
# ==============================================================================

# Optional. Gemini 3.7 Flash generates structured, evidence-linked advisories.
# Without a key, the app labels drafts as rule-based and image inspections as synthetic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Optional registered Earth Engine Cloud project and Application Default Credentials.
# Run `earthengine authenticate` on the server before setting the project.
GEE_PROJECT_ID=

# Optional pre-approved HTTPS receiver for reviewed advisories.
# Keep empty for the in-app test inbox only.
ADVISORY_WEBHOOK_URL=

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
